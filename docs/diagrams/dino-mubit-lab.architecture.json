    {
      "dot": "cyan",
      "title": "Local evidence",
      "items": [
        "The game runs in the browser. Files sit outside public/.",
        "Drafts, approvals and provider attempts retain their provenance."
      ]
    },
    {
      "dot": "emerald",
      "title": "Separate learning paths",
      "items": [
        "Memory adds approved answers to a prompt.",
        "The optional MLX command updates a separate local model."
      ]
    },
    {
      "dot": "amber",
      "title": "Unverified provider training",
      "items": [
        "No verified Mubit correction-upload or model-version contract.",
